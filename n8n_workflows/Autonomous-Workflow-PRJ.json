      "id": "2121c45a-8dee-4a27-bce8-8fefe0ecd286",
      "name": "XLS helper"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst fileTypeData = $('File Type').all();\n\nconst fileNameMap = {};\nfileTypeData.forEach((doc, index) => {\n  fileNameMap[index] = doc.json.fileName || `Document_${index + 1}`;\n});\n\nconst fileGroups = {};\n\nitems.forEach((item, index) => {\n  const fileName = fileNameMap[index] || `Document_${index + 1}`;\n\n  if (!fileGroups[fileName]) {\n    fileGroups[fileName] = [];\n  }\n\n  const text = item.json.data || item.json.text || '';\n  if (text.trim()) {\n    fileGroups[fileName].push(text);\n  }\n});\n\n// Return one item per file\nreturn Object.entries(fileGroups).map(([fileName, contents]) => ({\n  json: {\n    fileName: fileName,\n    fileContent: contents.join('\\n')\n  }\n}));"
      },
