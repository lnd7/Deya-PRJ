    {
      "parameters": {
        "jsCode": "let binaryData = $input.first()?.binary;\nif (!binaryData) {\n  try {\n    binaryData = $('When chat message received').item.binary;\n  } catch (e) {\n    binaryData = null;\n  }\n}\n\nif (!binaryData || Object.keys(binaryData).length === 0) {\n  return [{ \n    json: { \n      text: \"No attached files found. Please try uploading again.\",\n      error: true\n    } \n  }];\n}\n\nconst SUPPORTED_TYPES = ['pdf', 'txt', 'csv', 'xls', 'xlsx'];\nconst results = [];\nconst rejected = [];\n\nfor (const key of Object.keys(binaryData)) {\n  const file = binaryData[key];\n  const fileName = (file.fileName || 'unknown');\n  const fileNameLower = fileName.toLowerCase();\n  const mimeType = file.mimeType || '';\n\n  let fileType = null;\n\n  // PDF\n  if (mimeType.includes('pdf') || fileNameLower.endsWith('.pdf')) {\n    fileType = 'pdf';\n  }\n  // Text\n  else if (\n    mimeType.includes('text/plain') ||\n    fileNameLower.endsWith('.txt') ||\n    fileNameLower.endsWith('.md') ||\n    fileNameLower.endsWith('.rtf')\n  ) {\n    fileType = 'txt';\n  }\n  // CSV\n  else if (\n    mimeType.includes('text/csv') ||\n    mimeType.includes('application/csv') ||\n    fileNameLower.endsWith('.csv')\n  ) {\n    fileType = 'csv';\n  }\n  // XLS\n  else if (\n    mimeType.includes('application/vnd.ms-excel') ||\n    fileNameLower.endsWith('.xls')\n  ) {\n    fileType = 'xls';\n  }\n  // XLSX\n  else if (\n    mimeType.includes('spreadsheetml') ||\n    mimeType.includes('openxmlformats') ||\n    fileNameLower.endsWith('.xlsx')\n  ) {\n    fileType = 'xlsx';\n  }\n  // \u2500\u2500 Unsupported \u2500\u2500\n  else {\n    rejected.push(fileName);\n    continue; // skip this file\n  }\n\n  results.push({\n    json: {\n      fileName: fileName,\n      mimeType: mimeType,\n      fileType: fileType\n    },\n    binary: {\n      data: file\n    }\n  });\n}\n\n//If ALL files rejected\nif (results.length === 0) {\n  return [{\n    json: {\n      error: true,\n      text: `Unsupported file type(s): ${rejected.join(', ')}. Supported formats are: PDF, TXT, CSV, XLS, XLSX.`\n    }\n  }];\n}\n\n// If some files rejected, log warning but continue\nif (rejected.length > 0) {\n  results[0].json.warning = `Skipped unsupported file(s): ${rejected.join(', ')}`;\n}\n\nreturn results;\n"
      },
