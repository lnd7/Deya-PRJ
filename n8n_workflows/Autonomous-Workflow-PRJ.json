    {
      "parameters": {
        "jsCode": "const helperItems = $('helper').all();\n\nconst TOKEN_LIMIT = 7000;\nconst CHARS_PER_TOKEN = 4;\nconst MAX_CHARS = Math.floor(TOKEN_LIMIT * CHARS_PER_TOKEN * 0.9);\n\nconst results = [];\n\nhelperItems.forEach((item) => {\n  const text = typeof item.json.fileContent === 'string'\n    ? item.json.fileContent\n    : JSON.stringify(item.json.fileContent || '');\n  const fileName = item.json.fileName || 'Unknown Document';\n  const estimatedTokens = Math.ceil(text.length / CHARS_PER_TOKEN);\n\n  if (!text.trim()) return;\n\n  // Small files unchanged\n  if (estimatedTokens <= TOKEN_LIMIT) {\n    results.push({\n      json: {\n        filename: fileName,\n        content: text,\n        estimated_tokens: estimatedTokens,\n        is_split: false,\n        chunk_index: 1,\n        total_chunks: 1,\n        mode: 'direct'\n      }\n    });\n    return;\n  }\n\n  // Split large files\n  const chunks = [];\n  let start = 0;\n\n  while (start < text.length) {\n    let end = start + MAX_CHARS;\n\n    if (end < text.length) {\n      const nearestSpace = text.lastIndexOf(' ', end);\n      if (nearestSpace > start) end = nearestSpace;\n    }\n\n    const chunkText = text.slice(start, end).trim();\n    if (chunkText.length > 0) chunks.push(chunkText);\n    start = end + 1;\n  }\n\n  const totalChunks = chunks.length;\n\n  chunks.forEach((chunkText, index) => {\n    const chunkIndex = index + 1;\n    results.push({\n      json: {\n        filename: fileName,\n        content: chunkText,\n        estimated_tokens: Math.ceil(chunkText.length / CHARS_PER_TOKEN),\n        is_split: true,\n        chunk_index: chunkIndex,\n        total_chunks: totalChunks,\n        mode: chunkIndex === totalChunks ? 'final' : 'partial'\n      }\n    });\n  });\n});\n\nreturn results;"
      },
