    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst documentToolData = $('File Type').all();\nconst results = [];\n\nconst fileNameMap = {};\ndocumentToolData.forEach((doc, index) => {\n  fileNameMap[index] = doc.json.fileName || `Document_${index + 1}`;\n});\n\nitems.forEach((item, fileIndex) => {\n  let text = '';\n  let fileName = fileNameMap[fileIndex] || 'Unknown Document';\n\n  if (item.json.data && Array.isArray(item.json.data)) {\n    text = item.json.data\n      .map((page, pageIndex) => {\n        const pageText = (page.text || '').trim();\n\n        if (!pageText || pageText.length < 5) return null;\n\n        return `[Page ${pageIndex + 1}]\\n${pageText}`;\n      })\n      .filter(page => page !== null)\n      .join('\\n\\n');\n  }\n  else if (item.json.text) {\n    text = (item.json.text || '').trim();\n    fileName = item.json.fileName || fileName;\n  }\n\n  if (!text || text.trim().length < 10) return;\n\n  results.push({\n    json: {\n      fileName: fileName,\n      fileContent: text\n    }\n  });\n});\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        544
      ],
      "id": "5d757be5-90bf-4830-9437-102c9aa70999",
      "name": "pdf helper"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst fileName = $('CSV files loop').first().json.fileName || 'Unknown';\n\nreturn [{\n  json: {\n    fileName: fileName,\n    row_count: items.length,\n    fileContent: items.map(item => {\n      const row = {};\n      Object.entries(item.json)\n        .filter(([key]) => key !== 'myNewField')\n        .forEach(([key, value]) => row[key] = value);\n      return row;\n    })\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
