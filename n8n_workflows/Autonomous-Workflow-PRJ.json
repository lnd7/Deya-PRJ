      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst fileName = $('XLS files loop').first().json.fileName || 'Unknown';\n\nreturn [{\n  json: {\n    fileName: fileName,\n    row_count: items.length,\n    fileContent: items.map(item => {\n      const row = {};\n      Object.entries(item.json)\n        .filter(([key]) => key !== 'myNewField')\n        .forEach(([key, value]) => row[key] = value);\n      return row;\n    })\n  }\n}];"
      },
