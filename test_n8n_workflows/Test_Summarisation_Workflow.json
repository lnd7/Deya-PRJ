    {
      "parameters": {
        "jsCode": "const summaries = items.map((item, index) => {\n  const text = item.json.output?.text || item.json.text || item.json.output;\n  return `${text}`;\n}).join('\\n\\n---\\n\\n');\n\nreturn [{ json: { message: summaries } }];"
