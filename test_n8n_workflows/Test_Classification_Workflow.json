    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst parsed = items.map(item => {\n  const text = item.json.output?.text || item.json.text || item.json.output || '';\n\n  try {\n    const cleaned = text.replace(/```json|```/g, '').trim();\n    const data = JSON.parse(cleaned);\n    return `## ${data.filename} \\n ###### **Type:** ${data.document_type} \\n ###### **Category:** ${data.category} \\n ###### **Info:** ${data.info}`;\n  } catch (e) {\n    return text;\n  }\n}).join('\\n\\n---\\n\\n');\n\nreturn [{ json: { message: parsed } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
